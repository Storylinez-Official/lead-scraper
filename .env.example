# Required for running audits. The dashboard opens without it (read-only:
# you can browse past runs). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Raises the GitHub search API limit from 10 to 30 requests/minute.
# GITHUB_TOKEN=ghp_...

# Crawl limits
# CONTACT_MAX_PAGES=30
# DOCS_MAX_CANDIDATES=12
# DOCS_MAX_PAGES=8
# DOCS_SCORE_THRESHOLD=6

# Render JS-only pages (SPAs) with headless Chromium during crawling.
# RENDER_JS=true
# MAX_RENDERS_PER_LEAD=8
# Browser channel for Playwright. "chrome" uses installed Google Chrome, which
# passes Cloudflare checks more often. Leave empty to use bundled Chromium.
# BROWSER_CHANNEL=chrome

# CONCURRENCY=3
